  position: absolute;

  top: 3vh;
  left: 3vw;

  z-index: 10;

  width: 5vh;
  height: 5vh;

  border: none;
  border-radius: 50%;

  background: #ffffffcc;

  font-size: 3vh;

  display: flex;
  align-items: center;
  justify-content: center;

  cursor: pointer;
}

